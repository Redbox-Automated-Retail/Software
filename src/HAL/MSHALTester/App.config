<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler"/>
     <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Redbox.HAL.MSHALTester.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="Redbox.HAL.MSHALTester.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <log4net>
    <!-- Define some output appenders -->
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p: %m%n"/>
      </layout>
    </appender>
    <!-- RollingFileAppender looks after rolling over files by size or date -->
    <appender name="TesterLog" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="MSHALtester.log"/>
      <param name="AppendToFile" value="true"/>
      <param name="MaxSizeRollBackups" value="20"/>
      <param name="MaximumFileSize" value="1mb"/>
      <param name="RollingStyle" value="Size"/>
      <param name="StaticLogFileName" value="true"/>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p: %m%n"/>
      </layout>
    </appender>

    <logger name="TesterLog">
      <level value="INFO"/>
      <appender-ref ref="TesterLog"/>
    </logger>
  </log4net>
    <applicationSettings>
        <Redbox.HAL.MSHALTester.Properties.Settings>
            <setting name="CommunicationURL" serializeAs="String">
                <value>rcp://127.0.0.1:7001</value>
            </setting>
            <setting name="ImmediateMoveTimeout" serializeAs="String">
                <value>70000</value>
            </setting>
            <setting name="CheckForRunningHAL" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="AllowSessionDisplay" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="UsbServiceDebug" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="TestCommOnStartup" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="RouterRelayPause" serializeAs="String">
                <value>5000</value>
            </setting>
            <setting name="DisplayEngineeringTab" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ImageDirectory" serializeAs="String">
                <value>c:\Program Files\Redbox\HALService\video</value>
            </setting>
            <setting name="TunerApplication" serializeAs="String">
                <value>c:\Program Files\Redbox\halservice\bin\CameraTuner.exe</value>
            </setting>
            <setting name="TunerStartPause" serializeAs="String">
                <value>2500</value>
            </setting>
        </Redbox.HAL.MSHALTester.Properties.Settings>
    </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <userSettings>
    <Redbox.HAL.MSHALTester.Properties.Settings>
      <setting name="CountersFile" serializeAs="String">
        <value>c:\Program Files\Redbox\KioskLogs\ErrorLogs\Timeouts.log</value>
      </setting>
    </Redbox.HAL.MSHALTester.Properties.Settings>
  </userSettings>
</configuration>
