<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler"/>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Redbox.HAL.Service.Win32.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <log4net>
    <!-- Define some output appenders -->
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p: %m%n"/>
      </layout>
    </appender>
    <!-- RollingFileAppender looks after rolling over files by size or date -->
    <appender name="ServiceLog" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="C:\Program Files\Redbox\KioskLogs\Service\halsvc-win32.log"/>
      <param name="AppendToFile" value="true"/>
      <param name="MaxSizeRollBackups" value="20"/>
      <param name="MaximumFileSize" value="1mb"/>
      <param name="RollingStyle" value="Size"/>
      <param name="StaticLogFileName" value="true"/>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p: %m%n"/>
      </layout>
    </appender>

    <appender name="ErrorLog" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="C:\Program Files\Redbox\KioskLogs\ErrorLogs\HAL-err-log.log"/>
      <param name="AppendToFile" value="true"/>
      <param name="MaxSizeRollBackups" value="20"/>
      <param name="MaximumFileSize" value="1mb"/>
      <param name="RollingStyle" value="Size"/>
      <param name="StaticLogFileName" value="true"/>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p: %m%n"/>
      </layout>
    </appender>

    <logger name="ServiceLog">
      <level value="INFO"/>
      <appender-ref ref="ServiceLog"/>
    </logger>

    <logger name="ErrorLog">
      <level value="ERROR"/>
      <appender-ref ref="ErrorLog"/>
    </logger>
  </log4net>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <userSettings>
    <Redbox.HAL.Service.Win32.Properties.Settings>
      <setting name="MotionControlServiceVersion" serializeAs="String">
        <value>Modern</value>
      </setting>
      <setting name="CountersDBExclusiveMode" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="UsbServiceDebug" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="ServiceProtocol" serializeAs="String">
        <value>rcp://127.0.0.1:7001</value>
      </setting>
      <setting name="ServiceHostGeneration" serializeAs="String">
        <value>Legacy</value>
      </setting>
    </Redbox.HAL.Service.Win32.Properties.Settings>
  </userSettings>
</configuration>
