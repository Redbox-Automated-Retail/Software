<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>halsvc-win32</AssemblyName>
    <RootNamespace>Redbox.HAL.Service.Win32</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- Shipped self-contained, like the .NET 10 engine: the kiosk needs no .NET runtime installed. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- HALData/HALCounters are SQLite on .NET 10; existing VistaDB files are converted by this tool (build\VistaDbToSqlite.targets). -->
    <ShipVistaDbToSqlite>true</ShipVistaDbToSqlite>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Xml" />
    <Reference Include="log4net">
      <HintPath>..\..\..\lib\log4net\1.2.9\log4net.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <!-- NetFrameworkCompatibility.ImportExeConfig: halsvc-win32.exe.config stays the file kiosks and packages edit. -->
    <Compile Include="..\..\Common\Redbox.Core\NetFrameworkCompatibility.cs" Link="Compat\NetFrameworkCompatibility.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Redbox.HAL.Component.Model\Redbox.HAL.Component.Model.csproj" />
    <ProjectReference Include="..\Redbox.HAL.Configuration\Redbox.HAL.Configuration.csproj" />
    <ProjectReference Include="..\Redbox.HAL.Controller.Framework\Redbox.HAL.Controller.Framework.csproj" />
    <ProjectReference Include="..\Redbox.HAL.Core\Redbox.HAL.Core.csproj" />
    <ProjectReference Include="..\Redbox.HAL.DataMatrix.Framework\Redbox.HAL.DataMatrix.Framework.csproj" />
    <ProjectReference Include="..\Redbox.HAL.DataStorage\Redbox.HAL.DataStorage.csproj" />
    <ProjectReference Include="..\Redbox.HAL.IPC.Framework\Redbox.HAL.IPC.Framework.csproj" />
    <ProjectReference Include="..\Redbox.HAL.Script.Framework\Redbox.HAL.Script.Framework.csproj" />
  </ItemGroup>
  <Import Project="..\..\..\build\VistaDbToSqlite.targets" />
</Project>