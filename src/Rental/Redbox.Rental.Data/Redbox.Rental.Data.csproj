<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AssemblyName>Redbox.Rental.Data</AssemblyName>
    <RootNamespace>Redbox.Rental.Data</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- profile.data: VistaDB on .NET Framework, SQLite on .NET 10 (SqliteDatabaseProvider). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="SqliteDatabaseProvider.cs" />
    <Reference Include="VistaDB.NET20">
      <HintPath>..\..\..\lib\VistaDB\VistaDB.NET20.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\Redbox.Core\Redbox.Core.csproj" />
    <ProjectReference Include="..\..\KioskEngine\Redbox.KioskEngine.ComponentModel\Redbox.KioskEngine.ComponentModel.csproj" />
    <ProjectReference Include="..\..\KioskEngine\Redbox.KioskEngine.Environment\Redbox.KioskEngine.Environment.csproj" />
    <ProjectReference Include="..\..\KioskEngine\Redbox.KioskEngine.Kernel\Redbox.KioskEngine.Kernel.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.ProductLookupCatalog\Redbox.ProductLookupCatalog.csproj" />
    <ProjectReference Include="..\Redbox.Rental.Model\Redbox.Rental.Model.csproj" />
    <ProjectReference Include="..\Redbox.Rental.Services\Redbox.Rental.Services.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="VistaDBDatabaseProvider.cs" />
    <ProjectReference Include="..\..\Common\Redbox.Data.Sqlite\Redbox.Data.Sqlite.csproj" />
  </ItemGroup>
</Project>
