<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Redbox.HardwareServices.KernelExtension</AssemblyName>
    <RootNamespace>Redbox.HardwareServices.KernelExtension</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>True</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>True</UseWindowsForms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx" LogicalName="Redbox.HardwareServices.KernelExtension.Properties.Resources.resources" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DeviceService\DeviceService.ComponentModel\DeviceService.ComponentModel.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.Core\Redbox.Core.csproj" />
    <ProjectReference Include="..\Redbox.HardwareServices.Kernel\Redbox.HardwareServices.Kernel.csproj" />
    <ProjectReference Include="..\Redbox.HardwareServices.Proxy\Redbox.HardwareServices.Proxy.csproj" />
    <ProjectReference Include="..\Redbox.HardwareServices.Proxy.ComponentModel\Redbox.HardwareServices.Proxy.ComponentModel.csproj" />
    <ProjectReference Include="..\..\KioskEngine\Redbox.KioskEngine.ComponentModel\Redbox.KioskEngine.ComponentModel.csproj" />
    <ProjectReference Include="..\..\KioskEngine\Redbox.KioskEngine.Environment\Redbox.KioskEngine.Environment.csproj" />
    <ProjectReference Include="..\Redbox.HardwareServices.TestProxy\Redbox.HardwareServices.TestProxy.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
