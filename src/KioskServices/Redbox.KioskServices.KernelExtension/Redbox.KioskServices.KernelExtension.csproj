<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Redbox.KioskServices.KernelExtension</AssemblyName>
    <RootNamespace>Redbox.KioskServices.KernelExtension</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>True</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Redbox.KioskServices.Kernel\Redbox.KioskServices.Kernel.csproj" />
    <ProjectReference Include="..\Redbox.KioskServices.Proxy\Redbox.KioskServices.Proxy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Engine181Reference Include="Redbox.BrokerServices.Proxy.ComponentModel" />
    <Engine181Reference Include="Redbox.Core" />
    <Engine181Reference Include="Redbox.KioskEngine.ComponentModel" />
    <Engine181Reference Include="Redbox.KioskEngine.Environment" />
    <Engine181Reference Include="Redbox.KioskServices.Proxy.ComponentModel" />
    <Engine181Reference Include="Redbox.REDS.Framework" />
    <Engine181Reference Include="Redbox.Rental.Model" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <Import Project="..\Engine181.targets" />
</Project>
