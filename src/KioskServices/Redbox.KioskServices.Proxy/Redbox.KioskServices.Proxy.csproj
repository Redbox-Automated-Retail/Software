<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Redbox.KioskServices.Proxy</AssemblyName>
    <RootNamespace>Redbox.KioskServices.Proxy</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <Engine181Reference Include="DeviceService.ComponentModel" />
    <Engine181Reference Include="Redbox.Core" />
    <Engine181Reference Include="Redbox.KioskEngine.ComponentModel" />
    <Engine181Reference Include="Redbox.KioskEngine.Environment" />
    <Engine181Reference Include="Redbox.KioskServices.ComponentModel" />
    <Engine181Reference Include="Redbox.KioskServices.Proxy.ComponentModel" />
    <Engine181Reference Include="Redbox.REDS.Framework" />
    <Engine181Reference Include="Redbox.Rental.Model" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- .NET Remoting's HttpChannel replaced by Redbox.Remoting.Nrbf on .NET 10. -->
    <ProjectReference Include="..\..\Common\Redbox.Remoting.Nrbf\Redbox.Remoting.Nrbf.csproj" />
  </ItemGroup>
  <Import Project="..\Engine181.targets" />
</Project>
