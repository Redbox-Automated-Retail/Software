<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Redbox.KioskEngine.PreferenceManager</AssemblyName>
    <RootNamespace>Redbox.KioskEngine.PreferenceManager</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>True</UseWPF>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="assets\images\save.png" />
    <Resource Include="assets\images\save.png" />
    <None Remove="assets\images\refresh.png" />
    <Resource Include="assets\images\refresh.png" />
    <None Remove="assets\images\popout.png" />
    <Resource Include="assets\images\popout.png" />
    <None Remove="gear.ico" />
    <EmbeddedResource Include="gear.ico" LogicalName="gear.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\Redbox.Core\Redbox.Core.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.ComponentModel\Redbox.KioskEngine.ComponentModel.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Model\Redbox.Rental.Model.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Services\Redbox.Rental.Services.csproj" />
  </ItemGroup>
</Project>
