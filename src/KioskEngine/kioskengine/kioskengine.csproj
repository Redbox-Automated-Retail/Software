<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>kioskengine</AssemblyName>
    <RootNamespace>Redbox.KioskEngine.Bootstrap</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>True</UseWindowsForms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="HostForm.resx" LogicalName="Redbox.KioskEngine.Bootstrap.HostForm.resources" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="InputSimulator">
      <HintPath>..\..\..\lib\InputSimulator\InputSimulator.dll</HintPath>
    </Reference>
    <Reference Include="Interop.NetFwTypeLib">
      <HintPath>..\..\..\lib\Interop\Interop.NetFwTypeLib.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\KioskServices\Redbox.BrokerServices.KernelExtension\Redbox.BrokerServices.KernelExtension.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.Core\Redbox.Core.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.FraudServices.Proxy\Redbox.FraudServices.Proxy.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.FraudServices.Proxy.ComponentModel\Redbox.FraudServices.Proxy.ComponentModel.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.GetOpts\Redbox.GetOpts.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.HardwareServices.KernelExtension\Redbox.HardwareServices.KernelExtension.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.HardwareServices.Proxy\Redbox.HardwareServices.Proxy.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.HardwareServices.Proxy.ComponentModel\Redbox.HardwareServices.Proxy.ComponentModel.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.KioskDataServices.Proxy\Redbox.KioskDataServices.Proxy.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.KioskDataServices.Proxy.ComponentModel\Redbox.KioskDataServices.Proxy.ComponentModel.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.API\Redbox.KioskEngine.API.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.ComponentModel\Redbox.KioskEngine.ComponentModel.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.Drawing\Redbox.KioskEngine.Drawing.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.Environment\Redbox.KioskEngine.Environment.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.IDE\Redbox.KioskEngine.IDE.csproj" />
    <ProjectReference Include="..\Redbox.KioskEngine.Kernel\Redbox.KioskEngine.Kernel.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.Log.Framework\Redbox.Log.Framework.csproj" />
    <ProjectReference Include="..\..\Common\Redbox.REDS.Framework\Redbox.REDS.Framework.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Data\Redbox.Rental.Data.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Kernel\Redbox.Rental.Kernel.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Model\Redbox.Rental.Model.csproj" />
    <ProjectReference Include="..\..\Rental\Redbox.Rental.Services\Redbox.Rental.Services.csproj" />
    <ProjectReference Include="..\..\KioskServices\Redbox.UpdateServices.KernelExtension\Redbox.UpdateServices.KernelExtension.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
</Project>
