<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Added on the modernize branch (not decompiled). SQLite helpers for the .NET 10 builds that replace VistaDB, and
    the conversion of existing VistaDB files (run through tools/vistadb-to-sqlite, which needs .NET Framework).
    netstandard2.0, so both the .NET 10 components and the net48 converter use the same code.
  -->
  <PropertyGroup>
    <AssemblyName>Redbox.Data.Sqlite</AssemblyName>
    <RootNamespace>Redbox.Data.Sqlite</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
</Project>
