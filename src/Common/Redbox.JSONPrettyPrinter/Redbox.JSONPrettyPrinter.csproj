<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AssemblyName>Redbox.JSONPrettyPrinter</AssemblyName>
    <RootNamespace>Redbox.JSONPrettyPrinter</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Jayrock.Json">
      <HintPath>..\..\..\lib\Jayrock\Jayrock.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
</Project>
