<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AssemblyName>Redbox.Log.Framework</AssemblyName>
    <RootNamespace>Redbox.Log.Framework</RootNamespace>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2.0.8 as shipped on .NET Framework; its .NET Standard 1.3 build lacks most of the API, 2.0.17's netstandard2.0 build has it. -->
    <PackageReference Include="log4net" Version="2.0.8" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="log4net" Version="2.0.17" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Redbox.Core\Redbox.Core.csproj" />
  </ItemGroup>
</Project>
