<?xml version="1.0" encoding="utf-8" ?>
<!-- The store installer front end's settings, as Redbox shipped them. updatesvc.redbox.com resolves to the backend
     through the kiosk profile's hosts entries (step 1); Build-ClassicInstaller.ps1 puts the profile's own Update Service
     URL here when the profile uses DNS names. -->
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="Redbox.UpdateManager.StoreInstallerFrontEnd.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
    </startup>
    <applicationSettings>
        <Redbox.UpdateManager.StoreInstallerFrontEnd.Properties.Settings>
            <setting name="UpdateServiceUrl" serializeAs="String">
                <value>srcp://updatesvc.redbox.com:7002</value>
            </setting>
            <setting name="ManifestRoot" serializeAs="String">
                <value>..\.store\.repository</value>
            </setting>
            <setting name="DataStoreRoot" serializeAs="String">
                <value>..\.store\.data</value>
            </setting>
        </Redbox.UpdateManager.StoreInstallerFrontEnd.Properties.Settings>
    </applicationSettings>
</configuration>
