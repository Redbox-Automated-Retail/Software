<Project>
  <!-- Shared settings for all decompiled projects. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <Deterministic>true</Deterministic>
    <!-- Decompiled code: keep the build output readable. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0067;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0659;CS0660;CS0661;CS1998;CS8981;NU1603;NU1701;NU1902;NU1903;NU1904;NETSDK1138;MSB3270</NoWarn>
    <!-- .NET Core 2.x targets are end-of-life; restore them anyway. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>
  <!--
    Windows-only targets: these projects do not generate AssemblyInfo, so the SDK's SupportedOSPlatform("windows")
    attribute is missing and CA1416 would flag every Windows API call.
  -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- Opt-in: set RB_ARTIFACTS (or pass -p:ArtifactsPath=...) to put bin/obj outside the source tree. -->
  <PropertyGroup Condition="'$(ArtifactsPath)' == '' and '$(RB_ARTIFACTS)' != ''">
    <ArtifactsPath>$(RB_ARTIFACTS)</ArtifactsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArtifactsPath)' != ''">
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>
</Project>
